-- ПРОДВИНУТЫЙ АВТОПИЛОТ ДЛЯ CREATE A CART RIDE
-- Автоматически фармит круги, валюту и кристаллы

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- ================== КОНФИГУРАЦИЯ ==================
local TARGET_CART = "Rocket Cart" -- Самая быстрая машина
local SPEED_BOOST = 300            -- Максимальная скорость
local TORQUE_BOOST = 200           -- Ускорение
local TELEPORT_TO_FINISH = true    -- Телепорт к финишу для ускорения
local COLLECT_REWARDS = true       -- Собирать ProximityPrompt по пути
local CIRCLE_DELAY = 12            -- Задержка между кругами (сек)
local ANTI_AFK = true              -- Двигаться, чтобы не кикало за AFK
-- ====================================================

-- Переменные
local farming = false
local laps = 0
local startTime = 0
local startCrystals = 0
local startMoney = 0
local remotes = ReplicatedStorage:FindFirstChild("Remotes")
local spawnCart = remotes and remotes:FindFirstChild("SpawnCart")

-- Получение статистики
local function getStats()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if not ls then return 0, 0, 0 end
    local dist = ls:FindFirstChild("Distance")
    local cryst = ls:FindFirstChild("Crystals")
    local cs = LocalPlayer:FindFirstChild("CurrentSession")
    return (dist and dist.Value or 0), (cryst and cryst.Value or 0), (cs and cs.Value or 0)
end

-- Ускорение текущей машины
local function boostVehicle()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart then
        local seat = hum.SeatPart
        if seat:IsA("VehicleSeat") then
            seat.MaxSpeed = SPEED_BOOST
            seat.Torque = TORQUE_BOOST
            local cart = seat.Parent
            if cart:IsA("Model") and cart.PrimaryPart then
                cart.PrimaryPart.AssemblyLinearVelocity = cart.PrimaryPart.CFrame.LookVector * 150
            end
        end
    end
end

-- Телепорт к финишу
local function teleportToFinish()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local finish = Workspace:FindFirstChild("FinishLine") or Workspace:FindFirstChild("Finish")
    if not finish then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name:lower():find("finish") then finish = obj; break end
        end
    end
    if finish then
        hrp.CFrame = CFrame.new(finish.Position + Vector3.new(0, 10, 0))
    end
end

-- Сбор наград (ProximityPrompt)
local function collectRewards()
    if not COLLECT_REWARDS then return end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(obj) end)
        end
        if obj:IsA("ClickDetector") then
            pcall(function() fireclickdetector(obj) end)
        end
    end
end

-- Спавн машины
local function spawnVehicle(cartName)
    if spawnCart then
        pcall(function() spawnCart:FireServer(cartName or TARGET_CART) end)
    end
end

-- Анти-AFK (небольшие движения)
local function antiAFK()
    if not ANTI_AFK then return end
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.new(math.random(-1,1), 0, math.random(-1,1))
        end
    end
end

