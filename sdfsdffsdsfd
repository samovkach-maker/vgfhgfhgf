-- Обновление GUI
local function updateStats()
    local dist, cryst, money = getStats()
    local elapsed = tick() - startTime
    local elapsedStr = string.format("%.1f мин", elapsed / 60)
    local profitCryst = cryst - startCrystals
    local profitMoney = money - startMoney
    local rpm = laps / (elapsed / 60)
    
    statsLabel.Text = string.format(
        "⚡ Круги: %d (%.1f/мин)\n" ..
        "💎 Кристаллы: %d (+%d)\n" ..
        "💰 Деньги: %d (+%d)\n" ..
        "⏱ Время: %s",
        laps, rpm, cryst, profitCryst, money, profitMoney, elapsedStr
    )
end

-- Основной цикл фарма
local function farmLoop()
    startTime = tick()
    local _, startCrystals, startMoney = getStats()
    
    while farming do
        -- 1. Убедимся, что сидим в машине
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.SeatPart) then
            -- Спавним новую машину и пробуем сесть
            spawnVehicle()
            for _, seat in pairs(Workspace:GetDescendants()) do
                if seat:IsA("VehicleSeat") and seat.Parent.Name == TARGET_CART then
                    pcall(function() seat:Sit(hum) end)
                    break
                end
            end
        end
        
        -- 2. Ускоряемся
        boostVehicle()
        
        -- 3. Собираем награды
        collectRewards()
        
        -- 4. Ждём прохождения круга (в это время работаем анти-AFK)
        for i = 1, CIRCLE_DELAY do
            if not farming then break end
            if ANTI_AFK then antiAFK() end
            task.wait(1)
        end
        
        -- 5. Телепорт к финишу (если включен)
        if TELEPORT_TO_FINISH and farming then
            teleportToFinish()
            boostVehicle()
        end
        
        -- 6. Увеличиваем счётчик кругов
        if farming then
            laps = laps + 1
            updateStats()
        end
    end
end

-- Кнопки
startBtn.MouseButton1Click:Connect(function()
    if farming then return end
    farming = true
    laps = 0
    startBtn.Text = "В ПРОЦЕССЕ..."
    startBtn.BackgroundColor3 = Color3.fromRGB(180, 100, 0)
    
    -- Запускаем ферму
    task.spawn(farmLoop)
end)

stopBtn.MouseButton1Click:Connect(function()
    farming = false
    startBtn.Text = "СТАРТ"
    startBtn.BackgroundColor3 = Color3.fromRGB(30, 150, 30)
    updateStats()
end)

configBtn.MouseButton1Click:Connect(function()
    collectRewards()
    statsLabel.Text = statsLabel.Text .. "\n✅ Награды собраны!"
end)

-- Перетаскивание окна
local UIS = UserInputService
local dragging, startPos, startMouse
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        startPos = frame.Position
        startMouse = input.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - startMouse
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

