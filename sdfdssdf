-- Кнопки тестов
local tests = {
    {"Сканировать ВСЕ эвенты", function()
        log("=== СКАНИРОВАНИЕ ЭВЕНТОВ ===\n")
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            local name = obj.Name:lower()
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                if name:find("buy") or name:find("purchase") or name:find("cart") 
                   or name:find("car") or name:find("vehicle") or name:find("unlock")
                   or name:find("case") or name:find("crate") or name:find("chest")
                   or name:find("open") or name:find("spin") or name:find("roll")
                   or name:find("shop") or name:find("gamepass") or name:find("product") then
                    log("Найден: " .. obj:GetFullName() .. " [" .. obj.ClassName .. "]")
                end
            end
        end
    end},
    
    {"Активировать ВСЕ ClickDetector", function()
        log("=== АКТИВАЦИЯ CLICKDETECTOR ===\n")
        local count = 0
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ClickDetector") then
                local parent = obj.Parent
                local parentName = parent and parent.Name or "?"
                if parentName:lower():find("buy") or parentName:lower():find("shop")
                   or parentName:lower():find("case") or parentName:lower():find("crate")
                   or parentName:lower():find("car") or parentName:lower():find("cart")
                   or parentName:lower():find("unlock") or parentName:lower():find("purchase") then
                    log("ClickDetector: " .. parent:GetFullName())
                    for i = 1, 5 do
                        pcall(function() fireclickdetector(obj) end)
                        task.wait(0.05)
                    end
                    count = count + 1
                end
            end
        end
        log("Активировано: " .. count)
    end},
    
    {"Активировать ВСЕ ProximityPrompt", function()
        log("=== АКТИВАЦИЯ PROXIMITYPROMPT ===\n")
        local count = 0
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                pcall(function() fireproximityprompt(obj) end)
                count = count + 1
            end
        end
        log("Активировано: " .. count)
    end},
    
    {"Открыть ВСЕ кейсы (прямой вызов)", function()
        log("=== ПОПЫТКА ОТКРЫТЬ КЕЙСЫ ===\n")
        local caseFuncs = {"OpenCase", "OpenCrate", "OpenChest", "SpinCase", "RollCase", "UnlockCase", "Open"}
        for _, funcName in ipairs(caseFuncs) do
            for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
                if obj.Name == funcName then
                    log("Вызываю: " .. obj:GetFullName())
                    if obj:IsA("RemoteEvent") then
                        for i = 1, 10 do
                            pcall(function() obj:FireServer() end)
                            pcall(function() obj:FireServer(LocalPlayer) end)
                            pcall(function() obj:FireServer("All") end)
                            pcall(function() obj:FireServer(1) end)
                            pcall(function() obj:FireServer(100) end)
                            task.wait(0.03)
                        end
                    elseif obj:IsA("RemoteFunction") then
                        for i = 1, 10 do
                            pcall(function() obj:InvokeServer() end)
                            pcall(function() obj:InvokeServer("All") end)
                            pcall(function() obj:InvokeServer(100) end)
                            task.wait(0.03)
                        end
                    end
                end
            end
        end
    end},
    
    {"Попытка покупки без робуксов", function()
        log("=== ПОПЫТКА ПОКУПКИ ===\n")
        local buyFuncs = {"BuyItem", "PurchaseItem", "BuyCart", "BuyCar", "BuyVehicle", "Purchase", "Buy", "ShopBuy"}
        for _, funcName in ipairs(buyFuncs) do
            for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
                if obj.Name == funcName then
                    log("Вызываю: " .. obj:GetFullName())
                    if obj:IsA("RemoteEvent") then
                        pcall(function() obj:FireServer("All") end)
                        pcall(function() obj:FireServer(0) end)
                        pcall(function() obj:FireServer(-1) end)
                        pcall(function() obj:FireServer(nil) end)
                    elseif obj:IsA("RemoteFunction") then
                        pcall(function() obj:InvokeServer("All") end)
                        pcall(function() obj:InvokeServer(0) end)
                        pcall(function() obj:InvokeServer(-1) end)
                    end
                end
            end
        end
    end},
    
    {"Проверить _NETWORK функции", function()
        log("=== NETWORK ФУНКЦИИ ===\n")
        local network = ReplicatedStorage:FindFirstChild("_NETWORK")
        if network then
            for _, obj in pairs(network:GetDescendants()) do
                if obj:IsA("RemoteFunction") then
                    local success, result = pcall(function() return obj:InvokeServer() end)
                    if success then
                        log(obj.Name .. " = " .. tostring(result):sub(1, 50))
                    end
                end
            end
        end
    end},
}

