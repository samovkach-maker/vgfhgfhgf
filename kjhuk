AddLog("=== ДИАГНОСТИКА БАУНТИ ЗАПУЩЕНА ===")

-- 1. Поиск RemoteEvents
AddLog("\n[1] ПРОВЕРКА REPLICATEDSTORAGE:")
for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        local line = "Найден Remote: " .. obj.Name .. " | Тип: " .. obj.ClassName
        if string.find(obj.Name:lower(), "bounty") or string.find(obj.Name:lower(), "hit") or string.find(obj.Name:lower(), "kill") or string.find(obj.Name:lower(), "damage") then
            line = line .. " <<< ПОДОЗРИТЕЛЬНЫЙ >>>"
        end
        AddLog(line)
    end
end

-- 2. Поиск в _G
AddLog("\n[2] ПРОВЕРКА ГЛОБАЛЬНЫХ ПЕРЕМЕННЫХ (_G):")
local foundGlobal = false
for k, v in pairs(_G) do
    if type(k) == "string" then
        if string.find(k:lower(), "bounty") or string.find(k:lower(), "hit") or string.find(k:lower(), "kill") or string.find(k:lower(), "damage") then
            AddLog("_G." .. k .. " = " .. type(v))
            foundGlobal = true
        end
    end
end
if not foundGlobal then
    AddLog("Ничего подозрительного в _G не найдено.")
end

-- 3. Перехват RemoteEvent:FireServer
AddLog("\n[3] УСТАНОВКА ХУКОВ НА FIRESERVER:")
for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") then
        local oldFire = obj.FireServer
        obj.FireServer = function(self, ...)
            local args = {...}
            AddLog(">> FireServer перехвачен: " .. obj.Name)
            for i, arg in ipairs(args) do
                AddLog("   arg[" .. i .. "] = " .. tostring(arg) .. " (" .. type(arg) .. ")")
            end
            return oldFire(self, ...)
        end
        AddLog("Хук установлен на " .. obj.Name)
    end
end

-- 4. Отслеживание leaderstats
AddLog("\n[4] ОТСЛЕЖИВАНИЕ LEADERSTATS:")
for _, player in pairs(Players:GetPlayers()) do
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in pairs(leaderstats:GetChildren()) do
            if string.find(stat.Name:lower(), "bounty") or string.find(stat.Name:lower(), "score") or string.find(stat.Name:lower(), "points") or string.find(stat.Name:lower(), "kill") then
                AddLog("У " .. player.Name .. " найден stat: " .. stat.Name .. " = " .. tostring(stat.Value))
                stat:GetPropertyChangedSignal("Value"):Connect(function()
                    AddLog(">>> ИЗМЕНЕНИЕ: " .. player.Name .. " " .. stat.Name .. " = " .. stat.Value)
                end)
            end
        end
    end
end

-- 5. Отслеживание анимаций/инструментов
AddLog("\n[5] ОТСЛЕЖИВАНИЕ УДАРОВ (инструменты/анимации):")
local function trackCharacter(char)
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid:GetPropertyChangedSignal("Animator"):Connect(function()
            AddLog("Аниматор изменён у " .. char.Name)
        end)
    end
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            AddLog("Взят инструмент: " .. child.Name)
            child.ChildAdded:Connect(function(grandChild)
                if grandChild:IsA("RemoteEvent") then
                    AddLog("  В инструменте найден RemoteEvent: " .. grandChild.Name)
                end
            end)
        end
        if child:IsA("RemoteEvent") then
            AddLog("В персонаже найден RemoteEvent: " .. child.Name)
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(trackCharacter)
if LocalPlayer.Character then trackCharacter(LocalPlayer.Character) end

for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(trackCharacter)
        if player.Character then trackCharacter(player.Character) end
    end
end

-- 6. Отслеживание чата
AddLog("\n[6] ОТСЛЕЖИВАНИЕ ЧАТА (скрытые сообщения):")
local chat = game:GetService("Chat")
if chat then
    local oldSend = chat.SendMessageToServer
    if oldSend then
        chat.SendMessageToServer = function(self, message, ...)
            AddLog("Отправлено в чат: " .. message)
            return oldSend(self, message, ...)
        end
    end
end

