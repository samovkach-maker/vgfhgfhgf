-- ============ 6. МОНИТОРИНГ ХАРАКТЕРА ============
local function hookCharacter(char)
    log("Character", "Character загружен: " .. char.Name)
    
    -- Все Value объекты в персонаже
    for _, obj in pairs(char:GetDescendants()) do
        pcall(function()
            if obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("StringValue") or obj:IsA("BoolValue") then
                log("CharValue.Init", obj:GetFullName() .. " = " .. safeStr(obj.Value))
                obj.Changed:Connect(function(val)
                    if recording then
                        log("CharValue.Change", obj:GetFullName() .. " -> " .. safeStr(val))
                    end
                end)
                obj:GetPropertyChangedSignal("Value"):Connect(function()
                    if recording then
                        log("CharValue.Prop", obj:GetFullName() .. " -> " .. safeStr(obj.Value))
                    end
                end)
            end
            -- Атрибуты
            if obj:IsA("Model") or obj:IsA("Part") then
                obj:GetAttributeChangedSignal(""):Connect(function(attr)
                    if recording then
                        log("Attribute", obj:GetFullName() .. "." .. attr .. " = " .. safeStr(obj:GetAttribute(attr)))
                    end
                end)
            end
        end)
    end
    
    -- Humanoid
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum:GetPropertyChangedSignal("Health"):Connect(function()
            if recording then
                log("Humanoid", "Health = " .. hum.Health)
            end
        end)
    end
    
    -- Следим за новыми детьми
    char.DescendantAdded:Connect(function(obj)
        if recording then
            log("Char.DescendantAdded", obj:GetFullName() .. " <" .. obj.ClassName .. ">")
        end
    end)
end

if LocalPlayer.Character then
