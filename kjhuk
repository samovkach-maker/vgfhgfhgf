-- ============ 4. МОНИТОРИНГ LEADERSTATS ============
local function hookLeaderstats(ls)
    for _, stat in pairs(ls:GetChildren()) do
        pcall(function()
            if stat:IsA("IntValue") or stat:IsA("NumberValue") or stat:IsA("StringValue") or stat:IsA("DoubleConstrainedValue") then
                log("Leaderstats.Init", stat.Name .. " = " .. safeStr(stat.Value))
                stat.Changed:Connect(function(val)
                    if recording then
                        log("Leaderstats.Change", stat.Name .. " -> " .. safeStr(val))
                    end
                end)
                stat:GetPropertyChangedSignal("Value"):Connect(function()
                    if recording then
                        log("Leaderstats.ValueProp", stat.Name .. " -> " .. safeStr(stat.Value))
                    end
                end)
            end
        end)
    end
    ls.ChildAdded:Connect(function(child)
        if recording then
            log("Leaderstats.ChildAdded", child.Name .. " = " .. safeStr(child.Value))
        end
        pcall(function() hookLeaderstats(ls) end)
    end)
end

if LocalPlayer:FindFirstChild("leaderstats") then
