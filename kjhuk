-- Функция остановки записи
local function stopRecording()
    if not recording then return end
    recording = false
    log("SYSTEM", "=== ЗАПИСЬ ОСТАНОВЛЕНА. ВСЕГО СОБЫТИЙ: " .. eventCounter .. " ===")
    
    -- Отрезаем если слишком много
    if #logData > 500000 then
        logData = string.sub(logData, 1, 500000) .. "\n... (обрезано, слишком много данных)"
    end
    
    pcall(function() setclipboard(logData) end)
    StatusLabel.Text = "ГОТОВО! Ctrl+V в блокнот. Событий: " .. eventCounter
    RecordButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    RecordButton.Text = "СТАРТ ЗАПИСИ УДАРА"
    EventCountLabel.Text = "Событий: " .. eventCounter
    print("========== ТОТАЛЬНАЯ ДИАГНОСТИКА ==========")
    print(logData)
    print("========== КОНЕЦ ==========")
end

