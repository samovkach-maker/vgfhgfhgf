local logData = ""
local recording = false
local startTime = 0
local eventCounter = 0
local MAX_EVENTS = 5000

local function log(category, msg)
    eventCounter = eventCounter + 1
    if eventCounter > MAX_EVENTS then return end
    local timestamp = string.format("%.4f", tick() - startTime)
    local entry = "[" .. timestamp .. "][" .. category .. "] " .. msg
    logData = logData .. entry .. "\n"
end

-- Безопасный tostring для любых типов
local function safeStr(val)
    local success, result = pcall(function()
        if val == nil then return "nil"
        elseif type(val) == "table" then
            local t = ""
            local count = 0
            for k, v in pairs(val) do
                count = count + 1
                if count > 20 then t = t .. "...(truncated)"; break end
                local vStr = type(v) == "table" and "{...}" or tostring(v)
                t = t .. tostring(k) .. "=" .. vStr .. "; "
            end
            if count == 0 then
                -- пробуем индексы
                for i = 1, 20 do
                    local v = val[i]
                    if v == nil then break end
                    count = count + 1
                    t = t .. "[" .. i .. "]=" .. tostring(v) .. "; "
                end
            end
            return "TABLE[" .. count .. "]{" .. t .. "}"
        elseif typeof(val) == "userdata" then
            return "USERDATA<" .. typeof(val) .. ">"
        elseif type(val) == "function" then
            return "FUNCTION"
        elseif type(val) == "boolean" then
            return val and "true" or "false"
        else
            return tostring(val)
        end
    end)
    return success and result or "ERR"
end

-- ============ 1. ПЕРЕХВАТ ВСЕХ REMOTEEVENT (OnClientEvent) ============
local hookedRemotes = {}
for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
    pcall(function()
        if obj:IsA("RemoteEvent") then
            hookedRemotes[obj] = true
            obj.OnClientEvent:Connect(function(...)
                if not recording then return end
                local args = {...}
                local argStr = ""
                for i = 1, #args do
                    argStr = argStr .. "[" .. i .. "]=" .. safeStr(args[i]) .. " "
                end
                log("OnClientEvent", obj.Name .. " | " .. argStr)
            end)
        elseif obj:IsA("RemoteFunction") then
            hookedRemotes[obj] = true
            obj.OnClientInvoke = (function(originalInvoke)
                return function(...)
                    if not recording then return originalInvoke(...) end
                    local args = {...}
                    local argStr = ""
                    for i = 1, #args do
                        argStr = argStr .. "[" .. i .. "]=" .. safeStr(args[i]) .. " "
                    end
                    log("OnClientInvoke", obj.Name .. " | " .. argStr)
                    return originalInvoke(...)
                end
            end)(obj.OnClientInvoke)
        end
    end)
end

-- ============ 2. ПЕРЕХВАТ ВСЕХ FIRESERVER И INVOKESERVER ============
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if (method == "FireServer" or method == "InvokeServer") and recording then
        local name = "?"
        pcall(function()
            if self.Parent then name = self:GetFullName() end
        end)
        local argStr = ""
        for i = 1, #args do
            argStr = argStr .. "[" .. i .. "]=" .. safeStr(args[i]) .. " "
        end
        log(method, name .. " | " .. argStr)
    end
    
    return oldNamecall(self, ...)
end
setreadonly(mt, true)

