-- 1. Поиск RemoteEvents
AddLog("\n[1] ПРОВЕРКА REPLICATEDSTORAGE:")
local foundRemote = false
for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        foundRemote = true
        local line = "Найден Remote: " .. obj.Name .. " | Тип: " .. obj.ClassName
        if string.find(obj.Name:lower(), "bounty") or string.find(obj.Name:lower(), "hit") or string.find(obj.Name:lower(), "kill") or string.find(obj.Name:lower(), "damage") then
            line = line .. " <<< ПОДОЗРИТЕЛЬНЫЙ >>>"
        end
        AddLog(line)
    end
end
if not foundRemote then
    AddLog("RemoteEvent/Function не найдены в ReplicatedStorage.")
end

-- 2. Поиск в _G
AddLog("\n[2] ПРОВЕРКА ГЛОБАЛЬНЫХ ПЕРЕМЕННЫХ (_G):")
local foundGlobal = false
for k, v in pairs(_G) do
    if type(k) == "string" then
        local lower = string.lower(k)
        if string.find(lower, "bounty") or string.find(lower, "hit") or string.find(lower, "kill") or string.find(lower, "damage") or string.find(lower, "attack") then
            AddLog("_G." .. k .. " = " .. type(v))
            foundGlobal = true
        end
    end
end
if not foundGlobal then
    AddLog("Ничего подозрительного в _G не найдено.")
end

-- 3. Перехват RemoteEvent:FireServer
AddLog("\n[3] УСТАНОВКА ХУКОВ НА FIRESERVER:")
local hooked = 0
for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") then
        local oldFire = obj.FireServer
        obj.FireServer = function(self, ...)
            local args = {...}
            AddLog(">> FIRESERVER: " .. obj.Name)
            for i, arg in ipairs(args) do
                AddLog("   arg[" .. i .. "] = " .. tostring(arg) .. " (" .. type(arg) .. ")")
            end
            return oldFire(self, ...)
        end
        hooked = hooked + 1
        AddLog("Хук на " .. obj.Name)
    end
end
if hooked == 0 then
    AddLog("Нет RemoteEvent для хука.")
else
    AddLog("Всего установлено хуков: " .. hooked)
end

-- 4. Отслеживание leaderstats
AddLog("\n[4] ОТСЛЕЖИВАНИЕ LEADERSTATS:")
local statTracked = 0
for _, player in pairs(Players:GetPlayers()) do
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in pairs(leaderstats:GetChildren()) do
            if stat:IsA("IntValue") or stat:IsA("NumberValue") then
                local lower = string.lower(stat.Name)
                if string.find(lower, "bounty") or string.find(lower, "score") or string.find(lower, "points") or string.find(lower, "kill") or string.find(lower, "money") then
                    AddLog("У " .. player.Name .. " stat: " .. stat.Name .. " = " .. tostring(stat.Value))
                    stat:GetPropertyChangedSignal("Value"):Connect(function()
                        AddLog(">>> ИЗМЕНЕНИЕ: " .. player.Name .. " " .. stat.Name .. " = " .. stat.Value)
                    end)
                    statTracked = statTracked + 1
                end
            end
        end
    end
end
if statTracked == 0 then
    AddLog("Подозрительных stat не найдено.")
end

-- 5. Отслеживание инструментов и ударов
AddLog("\n[5] ОТСЛЕЖИВАНИЕ ИНСТРУМЕНТОВ И УДАРОВ:")
local function trackCharacter(char)
    if not char then return end
    AddLog("Отслеживание персонажа: " .. char.Name)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            AddLog("ВЗЯТ ИНСТРУМЕНТ: " .. child.Name)
            -- Проверяем, есть ли внутри RemoteEvent
            for _, sub in pairs(child:GetDescendants()) do
                if sub:IsA("RemoteEvent") then
                    AddLog("  >> В инструменте RemoteEvent: " .. sub.Name)
                end
            end
        end
        if child:IsA("RemoteEvent") then
            AddLog("RemoteEvent в персонаже: " .. child.Name)
        end
    end)
end

trackCharacter(LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait())
LocalPlayer.CharacterAdded:Connect(trackCharacter)

for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(trackCharacter)
        if player.Character then trackCharacter(player.Character) end
    end
end

