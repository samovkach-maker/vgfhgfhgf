btn.MouseButton1Click:Connect(function()
    status.Text = "Работаю..."
    
    -- 1. Открываем все кейсы
    findAndCall("case")
    findAndCall("crate")
    findAndCall("chest")
    findAndCall("open")
    
    -- 2. Покупаем всё
    findAndCall("buy")
    findAndCall("purchase")
    findAndCall("unlock")
    
    -- 3. Активируем все ClickDetector
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            pcall(function() fireclickdetector(obj) end)
        end
        if obj:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(obj) end)
        end
    end
    
    -- 4. NETWORK функции
    local net = ReplicatedStorage:FindFirstChild("_NETWORK")
    if net then
        for _, obj in pairs(net:GetDescendants()) do
            if obj:IsA("RemoteFunction") then
                pcall(function() obj:InvokeServer() end)
            end
        end
    end
    
    status.Text = "Готово! Проверь машины"
    print("Все методы выполнены!")
end)

