-- ВСЕ МАШИНЫ ОДНОЙ КНОПКОЙ (для телефона)
local LocalPlayer = game:GetService("Players").LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local function findAndCall(namePart)
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find(namePart) then
            if obj:IsA("RemoteEvent") then
                pcall(function() obj:FireServer() end)
                pcall(function() obj:FireServer(LocalPlayer) end)
                pcall(function() obj:FireServer("All") end)
                pcall(function() obj:FireServer(0) end)
            elseif obj:IsA("RemoteFunction") then
                pcall(function() obj:InvokeServer() end)
                pcall(function() obj:InvokeServer("All") end)
                pcall(function() obj:InvokeServer(0) end)
            end
        end
    end
end

