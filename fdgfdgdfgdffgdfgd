-- Попытка обмануть таймер через CurrentSession и другие IntValue
local LocalPlayer = game:GetService("Players").LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local remotes = ReplicatedStorage:FindFirstChild("Remotes")
local result = ""

-- Функция для попытки получения всех подарков
local function tryClaimAll()
    local claimGift = remotes:FindFirstChild("ClaimGift")
    if not claimGift then return end
    result = result .. "\nClaimGift после изменений:\n"
    for day = 1, 9 do
        local ok, res = pcall(function() return claimGift:InvokeServer(day) end)
        result = result .. "День " .. day .. ": " .. tostring(res) .. "\n"
        task.wait(0.1)
    end
end

-- 1. Манипуляции с CurrentSession (возможно, это время в секундах)
local cs = LocalPlayer:FindFirstChild("CurrentSession")
if cs then
    result = result .. "CurrentSession было: " .. cs.Value .. "\n"
    
    -- Пробуем установить очень большое значение (эмуляция долгой игры)
    cs.Value = 9999999
    result = result .. "CurrentSession стало: " .. cs.Value .. "\n"
    tryClaimAll()
    
    -- Пробуем установить 0 (сброс)
    cs.Value = 0
    task.wait(0.5)
    tryClaimAll()
    
    -- Возвращаем как было
    cs.Value = 9999999
end

-- 2. Ищем любые другие IntValue, которые могут быть таймером
result = result .. "\n=== ПОИСК ВСЕХ INTVALUE У LOCALPLAYER ===\n"
for _, child in pairs(LocalPlayer:GetChildren()) do
    if child:IsA("IntValue") or child:IsA("NumberValue") then
        result = result .. child.Name .. " = " .. child.Value .. "\n"
        -- Пробуем установить огромное значение
        child.Value = 9999999
        result = result .. "  -> установлено 9999999\n"
    end
end

-- 3. Ищем IntValue в Character
if LocalPlayer.Character then
    for _, obj in pairs(LocalPlayer.Character:GetDescendants()) do
        if obj:IsA("IntValue") and obj.Name:lower():find("time") then
            result = result .. "Найдено в Character: " .. obj:GetFullName() .. " = " .. obj.Value .. "\n"
            obj.Value = 9999999
            result = result .. "  -> установлено 9999999\n"
        end
    end
end

-- 4. Повторная попытка
tryClaimAll()

setclipboard(result)
print(result)
