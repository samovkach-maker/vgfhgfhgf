-- Расшифровка Reward и попытка получить все подарки
local modules = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
local LocalPlayer = game:GetService("Players").LocalPlayer
local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
local result = ""

if modules then
    local giftModule = modules:FindFirstChild("PlaytimeGifts")
    if giftModule then
        local ok, data = pcall(function() return require(giftModule) end)
        if ok and type(data) == "table" then
            result = result .. "=== НАГРАДЫ ЗА КАЖДЫЙ ДЕНЬ ===\n\n"
            
            for day = 1, #data do
                local dayData = data[day]
                result = result .. "День " .. day .. " (Время: " .. dayData.Time .. " сек):\n"
                
                local reward = dayData.Reward
                if type(reward) == "table" then
                    for k, v in pairs(reward) do
                        -- Если значение - таблица, расшифровываем её
                        if type(v) == "table" then
                            result = result .. "  " .. tostring(k) .. " = {\n"
                            for k2, v2 in pairs(v) do
                                result = result .. "    " .. tostring(k2) .. " = " .. tostring(v2) .. " [" .. typeof(v2) .. "]\n"
                            end
                            result = result .. "  }\n"
                        else
                            result = result .. "  " .. tostring(k) .. " = " .. tostring(v) .. " [" .. typeof(v) .. "]\n"
                        end
                    end
                else
                    result = result .. "  Reward = " .. tostring(reward) .. " [" .. typeof(reward) .. "]\n"
                end
                result = result .. "\n"
            end
        end
    end
end

-- Попытка обойти таймер: манипуляция с GetGiftData
result = result .. "\n=== ПОПЫТКА ОБХОДА ТАЙМЕРА ===\n"

-- Ищем IntValue, который хранит время
for _, child in pairs(LocalPlayer:GetChildren()) do
    if child:IsA("IntValue") and (child.Name:lower():find("time") or child.Name:lower():find("playtime") or child.Name:lower():find("session")) then
        result = result .. child.Name .. " было: " .. child.Value .. "\n"
        child.Value = 9999999
        result = result .. child.Name .. " стало: " .. child.Value .. "\n"
    end
end

-- Пробуем получить все подарки
local claimGift = remotes:FindFirstChild("ClaimGift")
if claimGift then
    result = result .. "\nClaimGift для всех дней:\n"
    for day = 1, 9 do
        local ok, res = pcall(function() return claimGift:InvokeServer(day) end)
        result = result .. "День " .. day .. ": " .. tostring(res) .. "\n"
        task.wait(0.1)
    end
end

setclipboard(result)
print(result)
