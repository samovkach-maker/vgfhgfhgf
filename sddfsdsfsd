local function makeButton(text, posX, posY, sizeX, sizeY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0,sizeX,0,sizeY)
    btn.Position = UDim2.new(0,posX,0,posY)
    btn.BackgroundColor3 = Color3.fromRGB(60,60,60)
    btn.Text = text
    btn.TextColor3 = Color3.white
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 11
    btn.Parent = btnPanel
    btn.MouseButton1Click:Connect(function()
        collectedData = ""
        callback()
        updateText()
    end)
    return btn
end

-- Функции сбора данных
local function analyzeRemoteFunctions()
    addLine("=== REMOTE FUNCTIONS ===")
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteFunction") then
            local ok, res = pcall(function() return obj:InvokeServer() end)
            if ok and res ~= nil then
                local s = tostring(res)
                if #s < 100 then addLine(obj.Name .. " = " .. s) end
            end
            task.wait(0.05)
        end
    end
end

local function analyzeRemoteEvents()
    addLine("=== REMOTE EVENTS (без вызова) ===")
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            addLine(obj:GetFullName())
        end
    end
end

local function analyzeWorkspace()
    addLine("=== СТРУКТУРА WORKSPACE ===")
    for _, child in pairs(Workspace:GetChildren()) do
        addLine(child.Name .. " [" .. child.ClassName .. "]")
    end
    addLine("\n=== PROXIMITYPROMPT ===")
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            addLine(obj.Parent:GetFullName())
        end
    end
    addLine("\n=== CLICKDETECTOR ===")
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            addLine(obj.Parent:GetFullName())
        end
    end
end

local function analyzePlayer()
    addLine("=== LOCALPLAYER ===")
    for _, child in pairs(LocalPlayer:GetChildren()) do
        if child:IsA("IntValue") or child:IsA("StringValue") then
            addLine(child.Name .. " = " .. tostring(child.Value))
        elseif child:IsA("Folder") then
            addLine(child.Name .. " (Folder):")
            for _, sub in pairs(child:GetChildren()) do
                addLine("  " .. sub.Name .. " = " .. tostring(sub.Value))
            end
        end
    end
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        addLine("\n=== LEADERSTATS ===")
        for _, stat in pairs(ls:GetChildren()) do
            addLine(stat.Name .. " = " .. tostring(stat.Value))
        end
    end
end

local function analyzeValues()
    addLine("=== VALUE ОБЪЕКТЫ В WORKSPACE ===")
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("IntValue") or obj:IsA("StringValue") or obj:IsA("NumberValue") then
            local v = "?"
            pcall(function() v = tostring(obj.Value) end)
            if #v < 40 then
                addLine(obj:GetFullName() .. " = " .. v)
            end
        end
    end
end

local function analyzeCarts()
    addLine("=== МАШИНЫ В REPLICATED STORAGE ===")
    local carts = ReplicatedStorage:FindFirstChild("Carts")
    if carts then
        for _, cart in pairs(carts:GetChildren()) do
            addLine(cart.Name)
        end
    end
    addLine("\n=== МАШИНЫ НА КАРТЕ (VehicleSeat) ===")
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") then
            addLine(obj.Parent:GetFullName())
        end
    end
end

local function tryExploit()
    addLine("=== ПОПЫТКА ЭКСПЛОЙТА ===")
    -- валюта
    local cs = LocalPlayer:FindFirstChild("CurrentSession")
    if cs then
        addLine("CurrentSession было: " .. cs.Value)
        cs.Value = 999999
        addLine("CurrentSession стало: " .. cs.Value)
    end
    -- цены кейсов
    local crates = Workspace:FindFirstChild("Crates")
    if crates then
        for _, obj in pairs(crates:GetDescendants()) do
            if obj.Name == "Price" and obj:IsA("IntValue") then
                addLine(obj.Parent.Name .. " цена: " .. obj.Value .. " -> 0")
                obj.Value = 0
            end
        end
    end
    -- активация ProximityPrompt
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            for i = 1, 10 do
                pcall(function() fireproximityprompt(obj) end)
            end
        end
    end
    addLine("Попытка завершена. Проверь инвентарь.")
end

